VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# 선택 사항: 설정하면 Open Library 결과와 Google Books 결과를 합쳐 검색합니다.
VITE_GOOGLE_BOOKS_API_KEY=YOUR_RESTRICTED_GOOGLE_BOOKS_API_KEY

# LiveKit Cloud를 연결한 뒤 true로 전환하세요. false이면 기존 P2P 음성을 사용합니다.
VITE_LIVEKIT_ENABLED=false
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_SERVER_API_KEY
LIVEKIT_API_SECRET=YOUR_SERVER_API_SECRET
# 선택 사항: 토큰 API를 별도 도메인에 배포했을 때만 설정합니다.
VITE_LIVEKIT_TOKEN_ENDPOINT=/api/livekit-token
